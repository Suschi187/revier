# Kopieren nach .env.local und Werte eintragen. .env.local ist in .gitignore.
# Lokale Supabase-Werte liefert `supabase status` (im Repo-Root).

# Öffentliche Basis-URL der Web-App (Canonical, hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: nur URL und anon-/publishable-Key, beide dürfen in den Browser
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sign in with Apple (ADR 010), erst mit Apple-Developer-Account und aktiviertem Provider
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# NUR SERVERSEITIG, nie mit NEXT_PUBLIC_-Präfix, nie im Browser. In M0 nicht verwendet.
# SUPABASE_SERVICE_ROLE_KEY=
