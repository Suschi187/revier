# Vorlage für deploy/.env (ignoriert). Je Umgebung eigene Werte.
RELEASE=2026-11-15
SITE_DOMAIN=example.de
ACME_EMAIL=technik@example.de
NEXT_PUBLIC_SITE_URL=https://example.de
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
# Nur der öffentliche anon-/publishable-Key, nie service_role (CLAUDE.md)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
# Nur in Prod true (ADR 015)
SITE_INDEXABLE=false
# Kartendatei im Ordner TILES_DIR, Name wie web/scripts/MAP-SOURCES.md
TILES_DIR=./tiles
MAP_TILES_FILE=
