-- Gemeinsame Test-Helfer (docs/adr/009). Wird von jeder Testdatei per \ir eingebunden und
-- liegt innerhalb der Test-Transaktion, verschwindet also mit dem Rollback.

create extension if not exists pgtap with schema extensions;
create schema if not exists tests;

-- Legt einen Nutzer in auth.users an; der Profil-Trigger (ab M1 Schritt 3) erzeugt das Profil.
-- `accepted`: hat den aktuellen Rechtstexten zugestimmt (Legal-Gate ab M3); false für Tests ohne Zustimmung.
create or replace function tests.create_user(email text, display_name text default null, accepted boolean default true)
returns uuid
language plpgsql
as $$
declare
  new_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, aud, role, email, raw_user_meta_data, created_at, updated_at)
  values (
    new_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', email,
    '{}'::jsonb, now(), now()
  );
  -- Der Trigger setzt nur den Platzhalter (Review M2); Testnamen direkt setzen.
  update public.profiles p set display_name = coalesce(create_user.display_name, split_part(email, '@', 1))
  where p.user_id = new_id;
  if accepted then
    insert into public.legal_acceptances (user_id, document, version, source) values
      (new_id, 'terms', private.setting_text('legal_terms_version'), 'web'),
      (new_id, 'privacy', private.setting_text('legal_privacy_version'), 'web');
  end if;
  return new_id;
end;
$$;

-- Füllt eine Anzeige so, dass sie die Bereitschaftsprüfung besteht (Plan M3 6): Beschreibung, Pflicht-
-- attribute je Art, Fläche, Wildart, Ort mit einer PLZ des Kreises. Als postgres aufrufen (Server-Pfad).
create or replace function tests.make_ready(listing uuid)
returns void
language plpgsql
as $$
declare
  l public.listings;
  code text;
begin
  select * into l from public.listings where id = listing;
  update public.listings set
    description = 'Beschreibung mit mehr als dreißig Zeichen für die Prüfung.',
    area_hectares = case when l.kind = 'lease' then 250 else area_hectares end,
    attributes = case l.kind
      when 'lease' then '{"lease_type": "genossenschaft", "revier_type": ["wald"]}'::jsonb
      when 'permit' then '{"permit_scope": "selbststaendig", "paid": true}'::jsonb
      when 'driven_hunt' then jsonb_build_object('event_date', to_char(current_date + 30, 'YYYY-MM-DD'), 'spots_available', 5)
      when 'trophy_hunt' then '{"legal_ack": true}'::jsonb
      else '{"tasks": ["Ansitz"]}'::jsonb
    end
  where id = listing;
  insert into public.listing_species (listing_id, species_code) values (listing, 'roe_deer') on conflict do nothing;
  select r.code into code from public.postal_code_regions r where r.region_id = l.region_id order by r.code limit 1;
  insert into public.listing_places (listing_id, postal_code, place_name) values (listing, code, 'Testort')
  on conflict (listing_id) do update set postal_code = excluded.postal_code, place_name = excluded.place_name;
end;
$$;

create or replace function tests.make_admin(user_id uuid)
returns void
language sql
as $$
  insert into private.user_roles (user_id, role) values (user_id, 'admin');
$$;

-- Wechselt in die Rolle authenticated mit passenden JWT-Claims. aal2 = 2FA bestätigt.
create or replace function tests.authenticate_as(user_id uuid, aal text default 'aal1')
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config(
    'request.jwt.claims',
    jsonb_build_object('sub', user_id, 'role', 'authenticated', 'aal', aal)::text,
    true
  );
end;
$$;

create or replace function tests.as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', '{"role": "anon"}', true);
end;
$$;

create or replace function tests.as_postgres()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

grant usage on schema tests to anon, authenticated;
grant execute on all functions in schema tests to anon, authenticated;
